<odoo>
  <data>
    <record model="ir.ui.view" id="inoc_base_view_partner_form">
      <field name="name">inoc_base_view_partner_form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="priority">30</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='child_ids']/form/sheet/div" position="inside">
          <p class="mb-0" invisible="type != 'legal'">
            <span>Preferred address for all legal contracts. Selected by default when you send e-signature.</span>
          </p>
        </xpath>
        <xpath expr="//field[@name='child_ids']//field[@name='title']" position="attributes">
          <attribute name="invisible">type != 'contact' and type != 'legal'</attribute>
        </xpath>
        <xpath expr="//field[@name='child_ids']//field[@name='function']" position="attributes">
          <attribute name="invisible">type != 'contact' and type != 'legal'</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>