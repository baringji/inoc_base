<odoo>
  <record model="ir.ui.view" id="inoc_res_config_settings_view_form">
    <field name="name">inoc_res_config_settings_view_form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app name="inoc_base" data-string="Inoc" string="inoc">
          <h2>Inoc App Settings</h2>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
